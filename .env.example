#the following numbers and placeholders for env keys are simply dummy values.

# Camera Settings (TP-Link Tapo/ONVIF)
CAMERA_IP=192.168.1.50
CAMERA_USER=admin
CAMERA_PASS=your_password_here
RTSP_PORT=554
ONVIF_PORT=2020

# Gemini
USE_GEMINI=false
GEMINI_API_KEY=AI.......

# Azure Telemetry
DEVICE_ID=instance_name
IOTHUB_CONN_STRING=HostName=myhub.azure-devices.net;DeviceId=myDevice;SharedAccessKey=xyz...
TELEMETRY_IMAGE_FORMAT=jpg
TELEMETRY_IMAGE_QUALITY=70
TELEMETRY_IMAGE_MAX_WIDTH=640

# Anomaly Detection Mode
# options: "fused" (recommended), "ssim", "mse"
# thresholds and tuning parameters are set in config/settings.py
TRAINING_MODE=fused
