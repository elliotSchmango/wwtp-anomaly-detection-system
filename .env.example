#the following numbers and placeholders for env keys are simply dummy values.

# Camera Settings (TP-Link Tapo/ONVIF)
CAMERA_IP=192.168.1.50
CAMERA_USER=admin
CAMERA_PASS=your_password_here
RTSP_PORT=554
ONVIF_PORT=2020

# Application Logic
SENTRY_FPS=5
# Telemetry interval (seconds)
SENTRY_TELEMETRY_INTERVAL_SEC=1800
# Adjust threshold based on calibration (Lower = More Sensitive)
AE_THRESHOLD_MSE=0.004
AE_THRESHOLD_SSIM=0.35

#gemini key
GEMINI_API_KEY=AI.......

# Azure Telemetry (leave empty to disable Azure logging)
IOTHUB_CONN_STRING=HostName=myhub.azure-devices.net;DeviceId=myDevice;SharedAccessKey=xyz...
DEVICE_ID=test-site
TELEMETRY_IMAGE_FORMAT=jpg
TELEMETRY_IMAGE_QUALITY=70
TELEMETRY_IMAGE_MAX_WIDTH=640
QUEUE_DB=sentry_results/queue.db

#CosmosDB integration
COSMOS_ENDPOINT=https://your-cosmos-db.documents.azure.com:443/
COSMOS_KEY=your_cosmos_primary_key
COSMOS_DATABASE=EagleDB
COSMOS_CONTAINER=Telemetry

AZURE_SENDER_DEBUG=false
